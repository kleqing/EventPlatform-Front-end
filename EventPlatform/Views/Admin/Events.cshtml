@{
    ViewData["Title"] = "Event Management";
}

<!-- === TAB: QUẢN LÝ SỰ KIỆN === -->
<section id="manage-events" class="content-section">
    <div class="card">
        <div class="card-header"><h3>Manage All Events</h3></div>
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Event Title</th>
                        <th>Submitted By</th>
                        <th>Event Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>New AI in Business Conference</td>
                        <td>User.Demo@example.com</td>
                        <td>2025-12-01</td>
                        <td><span class="status-badge status-pending">Pending</span></td>
                        <td class="table-actions">
                            <button class="btn btn-success btn-sm"><i class="fas fa-check"></i> Approve</button>
                            <button class="btn btn-danger btn-sm"><i class="fas fa-times"></i> Reject</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>