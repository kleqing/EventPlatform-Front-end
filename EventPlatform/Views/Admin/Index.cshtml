@{
    ViewData["Title"] = "Dashboard";
}

<section id="dashboard" class="content-section">
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon stat-icon-1"><i class="fas fa-dollar-sign"></i></div>
            <div class="stat-info">
                <h4 id="statRevenue">—</h4>
                <p>Total Revenue</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-2"><i class="fas fa-users"></i></div>
            <div class="stat-info">
                <h4 id="statUsers">—</h4>
                <p>Total Users</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-3"><i class="fas fa-calendar-check"></i></div>
            <div class="stat-info">
                <h4 id="statEvents">—</h4>
                <p>Total Events</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-4"><i class="fas fa-hourglass-half"></i></div>
            <div class="stat-info">
                <h4 id="statPending">—</h4>
                <p>Pending Approvals</p>
            </div>
        </div>
    </div>


    <div class="card" style="margin-top: 30px;">
        <div class="card-header"><h3>Site Visits (Last 7 Days)</h3></div>
        <div class="chart-container">
            <canvas id="visitsChart"></canvas>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h3>Quick Access: Pending Events</h3></div>
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Event Title</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="pendingEventsBody">
                    <tr><td colspan="3">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const API_BASE = window.API_BASE || "https://localhost:7063/api";
            const ADMIN_API = `${API_BASE}/admin`;

            const statRevenue = document.getElementById('statRevenue');
            const statUsers = document.getElementById('statUsers');
            const statEvents = document.getElementById('statEvents');
            const statPending = document.getElementById('statPending');
            const pendingBody = document.getElementById('pendingEventsBody');
            const chartCanvas = document.getElementById('visitsChart');

            let visitsChart;

            const currencyFormat = (value) =>
                new Intl.NumberFormat(undefined, { style: 'currency', currency: 'USD' }).format(value || 0);

            const numberFormat = (value) => new Intl.NumberFormat().format(value || 0);

            const handleErrorRow = (message) => {
                pendingBody.innerHTML = `<tr><td colspan="3">${message}</td></tr>`;
            };

            const loadSummary = async () => {
                try {
                    const res = await fetch(`${ADMIN_API}/dashboard/summary`, { credentials: 'include' });
                    if (!res.ok) throw new Error('Failed to load summary');
                    const summary = await res.json();
                    statRevenue.textContent = currencyFormat(summary.totalRevenue);
                    statUsers.textContent = numberFormat(summary.totalUsers);
                    statEvents.textContent = numberFormat(summary.totalEvents);
                    statPending.textContent = numberFormat(summary.pendingEvents);
                } catch (error) {
                    console.error(error);
                }
            };

            const loadPendingEvents = async () => {
                try {
                    const params = new URLSearchParams({ status: 'Pending', pageSize: 5, pageNumber: 1 });
                    const res = await fetch(`${ADMIN_API}/events?${params.toString()}`, { credentials: 'include' });
                    if (!res.ok) throw new Error('Failed to load pending events');
                    const data = await res.json();
                    const items = data.items || [];
                    if (!items.length) {
                        handleErrorRow('No pending events right now.');
                        return;
                    }

                    pendingBody.innerHTML = items.map(event => `
                        <tr>
                            <td>
                                <div><strong>${event.title}</strong></div>
                                <small class="text-muted">${new Date(event.startTime).toLocaleString()}</small>
                            </td>
                            <td><span class="status-badge status-pending">Pending</span></td>
                            <td class="table-actions">
                                <button class="btn btn-success btn-sm" data-event-id="${event.eventId}" data-action="approve"><i class="fas fa-check"></i> Approve</button>
                                <button class="btn btn-danger btn-sm" data-event-id="${event.eventId}" data-action="reject"><i class="fas fa-times"></i> Reject</button>
                            </td>
                        </tr>`).join('');
                } catch (error) {
                    console.error(error);
                    handleErrorRow('Failed to load pending events.');
                }
            };

            pendingBody.addEventListener('click', async (event) => {
                const button = event.target.closest('button[data-event-id]');
                if (!button) return;
                const eventId = button.dataset.eventId;
                const action = button.dataset.action;
                button.disabled = true;
                try {
                    const endpoint = action === 'approve' ? 'approve' : 'reject';
                    await fetch(`${ADMIN_API}/events/${eventId}/${endpoint}`, {
                        method: 'POST',
                        credentials: 'include',
                        headers: { 'Content-Type': 'application/json' },
                        body: action === 'reject' ? JSON.stringify({ reason: 'Rejected on dashboard' }) : null
                    });
                    await loadPendingEvents();
                } catch (error) {
                    console.error(error);
                    alert('Failed to update event status.');
                } finally {
                    button.disabled = false;
                }
            });

            const buildVisitsChart = async () => {
                if (!chartCanvas) return;
                try {
                    const params = new URLSearchParams({ pageSize: 100, pageNumber: 1 });
                    const res = await fetch(`${ADMIN_API}/transactions?${params.toString()}`, { credentials: 'include' });
                    if (!res.ok) throw new Error('Failed to load transactions');
                    const data = await res.json();
                    const items = data.items || [];
                    const now = new Date();
                    const days = Array.from({ length: 7 }).map((_, idx) => {
                        const date = new Date(now);
                        date.setDate(now.getDate() - (6 - idx));
                        const key = date.toISOString().split('T')[0];
                        return { label: date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }), key, total: 0 };
                    });

                    items.forEach(tx => {
                        if (!tx.transactionDate) return;
                        const key = tx.transactionDate.split('T')[0];
                        const bucket = days.find(d => d.key === key);
                        if (bucket) bucket.total += tx.amount;
                    });

                    const labels = days.map(d => d.label);
                    const values = days.map(d => d.total);

                    if (visitsChart) {
                        visitsChart.data.labels = labels;
                        visitsChart.data.datasets[0].data = values;
                        visitsChart.update();
                    } else {
                        visitsChart = new Chart(chartCanvas, {
                            type: 'line',
                            data: {
                                labels,
                                datasets: [{
                                    label: 'Revenue (last 7 days)',
                                    data: values,
                                    borderColor: 'var(--primary-color)',
                                    backgroundColor: 'rgba(233, 30, 99, 0.1)',
                                    fill: true,
                                    tension: 0.4
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    y: {
                                        beginAtZero: true
                                    }
                                }
                            }
                        });
                    }
                } catch (error) {
                    console.error(error);
                }
            };

            loadSummary();
            loadPendingEvents();
            buildVisitsChart();
        })();
    </script>
}