@{
    ViewData["Title"] = "User Management";
}

<!-- === TAB: QUẢN LÝ USER === -->
<section id="manage-users" class="content-section">
    <div class="card">
        <div class="card-header"><h3>Manage Users</h3></div>
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="user-cell">
                                <img src="https://via.placeholder.com/40x40/e91e63/fff?text=SA" alt="Avatar">
                                <strong>Santiago Axel</strong>
                            </div>
                        </td>
                        <td>santiago.axel@example.com</td>
                        <td>Speaker</td>
                        <td><span class="status-badge status-active">Active</span></td>
                        <td class="table-actions">
                            <button class="btn btn-secondary btn-sm"><i class="fas fa-user-shield"></i> Make Admin</button>
                            <button class="btn btn-danger btn-sm"><i class="fas fa-ban"></i> Ban</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>