    <script>
        window.API_BASE = window.API_BASE || "https://eventplatform.runasp.net/api";
        window.HUB_URL = window.HUB_URL || "https://eventplatform.runasp.net/hubs/chat";
    </script>
    <script>
        const API_BASE = window.API_BASE;
        const HUB_URL = window.HUB_URL;

        let currentUserId = null;
        let currentUserIdNormalized = null;
        let currentUserEmail = null;
        let currentUserName = null;

        let chatHubConnection = null;
        let activeConversationId = null;
        let activeChatPartner = null;
        const renderedMessageIds = new Set();
        let conversations = [];

        const normalizeId = (value) => {
            if (value === null || value === undefined) {
                return null;
            }
            return value.toString().trim().toLowerCase();
        };
        window.normalizeId = normalizeId;

        const escapeHtml = (unsafeValue) => {
            if (unsafeValue === null || unsafeValue === undefined) {
                return '';
            }
            return unsafeValue
                .toString()
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        };
        window.escapeHtml = escapeHtml;

        const isMessageMine = (message) => {
            if (!message) {
                return false;
            }
            if (message.isMine === true) {
                if (!message.senderId && currentUserId) {
                    message.senderId = currentUserId;
                }
                return true;
            }
            if (message.isMine === false) {
                return false;
            }
            if (!message.senderId || !currentUserIdNormalized) {
                return false;
            }
            return normalizeId(message.senderId) === currentUserIdNormalized;
        };
        window.isMessageMine = isMessageMine;

        document.addEventListener('DOMContentLoaded', async function () {
            // === Code điều khiển Tab Sidebar ===
            const navLinks = document.querySelectorAll('.sidebar-nav a');
            const contentSections = document.querySelectorAll('.content-section');

            const chatMessagesContainer = document.getElementById('chatMessages');
            const chatMessageForm = document.getElementById('chatMessageForm');
            const chatMessageInput = document.getElementById('chatMessageInput');
            const chatSearchEmailInput = document.getElementById('chatSearchEmail');
            const chatSearchButton = document.getElementById('chatSearchButton');
            const chatSearchFeedback = document.getElementById('chatSearchFeedback');
            const chatWidget = document.getElementById('chatWidget');
            const chatPartnerNameEl = document.getElementById('chatPartnerName');
            const closeChatBtn = document.getElementById('closeChatBtn');
            const partnerSection = document.getElementById('partner-recommendations');
            const conversationListContainer = document.getElementById('conversationList');
            let myEvents = []; // Giữ dữ liệu sự kiện cho lịch

            function switchTab(targetId) {
                navLinks.forEach(nav => {
                    if (nav.getAttribute('href') === targetId) {
                        nav.classList.add('active');
                    } else {
                        nav.classList.remove('active');
                    }
                });

                contentSections.forEach(section => {
                    if ('#' + section.id === targetId) {
                        section.classList.add('active');
                    } else {
                        section.classList.remove('active');
                    }
                });

                if (targetId === '#applied-events') {
                    if (!calendar && calendarEl && myEvents) {
                        calendar = new FullCalendar.Calendar(calendarEl, {
                            initialView: 'dayGridMonth',
                            headerToolbar: {
                                left: 'prev,next today',
                                center: 'title',
                                right: 'dayGridMonth,timeGridWeek'
                            },
                            events: myEvents,
                            eventClick: function (info) {
                                info.jsEvent.preventDefault();
                                openEventModal(
                                    info.event.title,
                                    info.event.start,
                                    info.event.end,
                                    info.event.extendedProps.location,
                                    info.event.extendedProps.type,
                                    info.event.extendedProps.icon
                                );
                            }
                        });
                        calendar.render();
                    } else if (calendar) {
                        calendar.render();
                    }
                }
            }

            const truncate = (value, maxLength = 60) => {
                if (!value) {
                    return '';
                }
                const text = value.toString();
                if (text.length <= maxLength) {
                    return text;
                }
                return text.slice(0, Math.max(0, maxLength - 3)) + '...';
            };

            const formatConversationTimestamp = (isoString) => {
                if (!isoString) {
                    return '';
                }
                const date = new Date(isoString);
                if (Number.isNaN(date.getTime())) {
                    return '';
                }
                const now = new Date();
                if (date.toDateString() === now.toDateString()) {
                    return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                }
                const yesterday = new Date(now);
                yesterday.setDate(now.getDate() - 1);
                if (date.toDateString() === yesterday.toDateString()) {
                    return 'Yesterday';
                }
                return date.toLocaleDateString();
            };

            const normalizeId = (value) => {
                if (value === null || value === undefined) {
                    return null;
                }
                return value.toString().trim().toLowerCase();
            };

            const isMessageMine = (message) => {
                if (!message) {
                    return false;
                }
                if (message.isMine === true) {
                    if (!message.senderId && currentUserId) {
                        message.senderId = currentUserId;
                    }
                    return true;
                }
                if (message.isMine === false) {
                    return false;
                }
                if (!message.senderId || !currentUserIdNormalized) {
                    return false;
                }
                return normalizeId(message.senderId) === currentUserIdNormalized;
            };

            const renderConversationList = (items) => {
                if (!conversationListContainer) {
                    return;
                }
                conversationListContainer.innerHTML = '';

                if (!items || items.length === 0) {
                    const emptyState = document.createElement('div');
                    emptyState.className = 'conversation-empty';
                    emptyState.textContent = 'Start a chat to see it appear here.';
                    conversationListContainer.appendChild(emptyState);
                    return;
                }

                const ordered = [...items].sort((a, b) => {
                    const aTime = new Date(a.lastMessage?.sentAt || a.updatedAt || 0).getTime();
                    const bTime = new Date(b.lastMessage?.sentAt || b.updatedAt || 0).getTime();
                    return bTime - aTime;
                });

                ordered.forEach(conversation => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'conversation-item';
                    if (conversation.conversationId === activeConversationId) {
                        button.classList.add('active');
                    }
                    button.dataset.conversationId = conversation.conversationId;

                    const avatar = document.createElement('div');
                    avatar.className = 'conversation-avatar';
                    const avatarImg = document.createElement('img');
                    avatarImg.alt = conversation.participant?.fullName || conversation.participant?.email || 'Participant';
                    avatarImg.src = conversation.participant?.avatarUrl || 'https://via.placeholder.com/48x48/1f2937/ffffff?text=U';
                    avatar.appendChild(avatarImg);

                    const textWrapper = document.createElement('div');
                    textWrapper.className = 'conversation-text';

                    const nameEl = document.createElement('span');
                    nameEl.className = 'conversation-name';
                    nameEl.textContent = conversation.participant?.fullName || conversation.participant?.email || 'Participant';

                    const snippetEl = document.createElement('span');
                    snippetEl.className = 'conversation-snippet';
                    const snippetSource = conversation.lastMessage?.content || 'Say hello to get started.';
                    snippetEl.textContent = truncate(snippetSource, 60);

                    textWrapper.appendChild(nameEl);
                    textWrapper.appendChild(snippetEl);

                    const timeEl = document.createElement('span');
                    timeEl.className = 'conversation-time';
                    timeEl.textContent = formatConversationTimestamp(conversation.lastMessage?.sentAt || conversation.updatedAt);

                    button.appendChild(avatar);
                    button.appendChild(textWrapper);
                    button.appendChild(timeEl);

                    conversationListContainer.appendChild(button);
                });
            };

            const upsertConversation = (conversation) => {
                if (!conversation) {
                    return;
                }
                const index = conversations.findIndex(item => item.conversationId === conversation.conversationId);
                if (index >= 0) {
                    conversations[index] = { ...conversations[index], ...conversation };
                } else {
                    conversations.push(conversation);
                }
                renderConversationList(conversations);
            };

            const updateConversationPreviewFromMessage = (message) => {
                if (!message) {
                    return;
                }
                const target = conversations.find(item => item.conversationId === message.conversationId);
                if (!target) {
                    loadConversations().catch(err => console.error(err));
                    return;
                }
                target.lastMessage = {
                    content: message.content,
                    sentAt: message.sentAt,
                    senderId: message.senderId
                };
                target.updatedAt = message.sentAt || target.updatedAt;
                renderConversationList(conversations);
            };

            const loadConversations = async () => {
                if (!conversationListContainer) {
                    return;
                }
                try {
                    const res = await fetch(`${API_BASE}/chat/conversations`, {
                        credentials: 'include'
                    });
                    const payload = await res.json();
                    if (!res.ok) {
                        throw new Error(payload.message || 'Unable to load conversations');
                    }
                    conversations = payload.data || [];
                    renderConversationList(conversations);
                } catch (error) {
                    console.error(error);
                    conversationListContainer.innerHTML = '<div class="conversation-empty">Unable to load conversations.</div>';
                }
            };

            const renderSearchFeedback = (markup, isError = false) => {
                if (!chatSearchFeedback) return;
                if (!markup) {
                    chatSearchFeedback.innerHTML = "";
                    chatSearchFeedback.classList.remove("has-error");
                    return;
                }

                if (isError) {
                    chatSearchFeedback.classList.add("has-error");
                } else {
                    chatSearchFeedback.classList.remove("has-error");
                }

                chatSearchFeedback.innerHTML = markup;
            };

            const appendMessage = (message) => {
                if (!message || !chatMessagesContainer) return;
                if (!message.messageId) {
                    const fallbackId = typeof crypto !== 'undefined' && crypto.randomUUID
                        ? crypto.randomUUID()
                        : `${Date.now()}-${Math.random().toString(36).slice(2)}`;
                    message.messageId = fallbackId;
                }
                if (renderedMessageIds.has(message.messageId)) {
                    return;
                }

                renderedMessageIds.add(message.messageId);

                const mine = isMessageMine(message);
                const wrapper = document.createElement('div');
                wrapper.className = `message ${mine ? 'sent' : 'received'}`;

                const textEl = document.createElement('span');
                textEl.className = 'message-text';
                textEl.textContent = message.content ?? '';

                const metaEl = document.createElement('span');
                metaEl.className = 'message-meta';
                const sentAt = message.sentAt ? new Date(message.sentAt) : new Date();
                metaEl.textContent = sentAt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                wrapper.appendChild(textEl);
                wrapper.appendChild(metaEl);
                chatMessagesContainer.appendChild(wrapper);
                chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight;
            };

            const renderMessages = (messages) => {
                if (!chatMessagesContainer) return;
                chatMessagesContainer.innerHTML = "";
                renderedMessageIds.clear();

                if (!messages || messages.length === 0) {
                    const empty = document.createElement('div');
                    empty.className = 'message received';
                    empty.textContent = 'No messages yet. Say hello 👋';
                    chatMessagesContainer.appendChild(empty);
                    return;
                }

                messages.forEach(msg => appendMessage(msg));
            };

            const loadConversationMessages = async (conversationId) => {
                if (!conversationId) return;
                try {
                    const res = await fetch(`${API_BASE}/chat/conversations/${conversationId}/messages?page=1&pageSize=50`, {
                        credentials: 'include'
                    });
                    const payload = await res.json();
                    if (!res.ok) {
                        throw new Error(payload.message || 'Unable to load messages');
                    }
                    renderMessages(payload.data || []);
                } catch (error) {
                    console.error(error);
                    if (chatMessagesContainer) {
                        chatMessagesContainer.innerHTML = '<div class="message received">Unable to load messages.</div>';
                    }
                }
            };

            const handleReceiveMessage = (message) => {
                if (!message) {
                    return;
                }
                updateConversationPreviewFromMessage(message);
                if (!activeConversationId || message.conversationId !== activeConversationId) {
                    return;
                }

                const container = document.getElementById('messengerMessages');
                if (container && !renderedMessageIds.has(message.messageId)) {
                    renderedMessageIds.add(message.messageId);
                    appendMessageToMessenger(message);
                }
            };

            const handleConversationUpdated = (conversation) => {
                if (!conversation) {
                    return;
                }
                upsertConversation(conversation);
                if (conversation.conversationId !== activeConversationId) {
                    return;
                }
                activeChatPartner = conversation.participant;
                if (chatPartnerNameEl) {
                    chatPartnerNameEl.textContent = 'Chat với ' + (conversation.participant?.fullName || 'Participant');
                }
            };

            const ensureChatHubConnection = async () => {
                if (typeof signalR === 'undefined') {
                    console.warn('SignalR library is not available.');
                    return null;
                }

                if (!chatHubConnection) {
                    chatHubConnection = new signalR.HubConnectionBuilder()
                        .withUrl(HUB_URL, { withCredentials: true })
                        .withAutomaticReconnect()
                        .build();

                    chatHubConnection.on('ReceiveMessage', handleReceiveMessage);
                    chatHubConnection.on('ConversationUpdated', handleConversationUpdated);
                }

                if (chatHubConnection.state === signalR.HubConnectionState.Disconnected) {
                    try {
                        await chatHubConnection.start();
                    } catch (error) {
                        console.error('Unable to start chat connection', error);
                        return null;
                    }
                }

                return chatHubConnection;
            };

            const joinConversationGroup = async (conversationId) => {
                if (!conversationId) return;
                try {
                    const hub = await ensureChatHubConnection();
                    await hub?.invoke('JoinConversation', conversationId);
                } catch (error) {
                    console.error('Failed to join conversation group', error);
                }
            };

            const leaveConversationGroup = async (conversationId) => {
                if (!conversationId || !chatHubConnection) return;
                try {
                    await chatHubConnection.invoke('LeaveConversation', conversationId);
                } catch (error) {
                    console.error('Failed to leave conversation group', error);
                }
            };

            const openConversation = async (conversation) => {
                if (!conversation) return;

                if (activeConversationId && activeConversationId !== conversation.conversationId) {
                    await leaveConversationGroup(activeConversationId);
                    renderedMessageIds.clear();
                }

                activeConversationId = conversation.conversationId;
                activeChatPartner = conversation.participant;

                renderConversationList(conversations);

                // Update messenger UI
                const messengerPlaceholder = document.getElementById('messengerPlaceholder');
                const messengerChatView = document.getElementById('messengerChatView');
                const activeChatAvatar = document.getElementById('activeChatAvatar');
                const activeChatName = document.getElementById('activeChatName');
                const messengerMessages = document.getElementById('messengerMessages');
                const messengerMessageInput = document.getElementById('messengerMessageInput');

                if (messengerPlaceholder) messengerPlaceholder.style.display = 'none';
                if (messengerChatView) messengerChatView.style.display = 'flex';

                if (activeChatAvatar && conversation.participant?.avatarUrl) {
                    activeChatAvatar.src = conversation.participant.avatarUrl;
                }
                if (activeChatName) {
                    activeChatName.textContent = conversation.participant?.fullName || 'Participant';
                }

                if (messengerMessages) {
                    renderedMessageIds.clear();
                    messengerMessages.innerHTML = '<div class="message-loading">Loading messages...</div>';
                }

                if (messengerMessageInput) {
                    messengerMessageInput.value = '';
                    messengerMessageInput.focus();
                }

                await joinConversationGroup(conversation.conversationId);
                await loadConversationMessagesForMessenger(conversation.conversationId);
            };

            const loadConversationMessagesForMessenger = async (conversationId) => {
                if (!conversationId) return;
                const container = document.getElementById('messengerMessages');
                if (!container) return;

                try {
                    const res = await fetch(`${API_BASE}/chat/conversations/${conversationId}/messages?page=1&pageSize=50`, {
                        credentials: 'include'
                    });
                    const payload = await res.json();
                    if (!res.ok) {
                        throw new Error(payload.message || 'Unable to load messages');
                    }
                    const messages = payload.data || [];
                    renderMessagesInMessenger(messages);
                    container.scrollTop = container.scrollHeight;
                } catch (error) {
                    console.error(error);
                    container.innerHTML = '<div class="message-loading" style="color: #dc2626;">Unable to load messages.</div>';
                }
            };

            const renderMessagesInMessenger = (messages) => {
                const container = document.getElementById('messengerMessages');
                if (!container) return;
                container.innerHTML = '';

                if (!messages || messages.length === 0) {
                    container.innerHTML = '<div class="message-loading">No messages yet. Say hello!</div>';
                    return;
                }

                messages.forEach(msg => {
                    if (!renderedMessageIds.has(msg.messageId)) {
                        renderedMessageIds.add(msg.messageId);
                        appendMessageToMessenger(msg);
                    }
                });
            };

            const appendMessageToMessenger = (message) => {
                const container = document.getElementById('messengerMessages');
                if (!container) return;

                const mine = isMessageMine(message);
                const div = document.createElement('div');
                div.className = mine ? 'message sent' : 'message received';
                div.dataset.messageId = message.messageId;

                const bubble = document.createElement('div');
                bubble.className = 'message-bubble';
                bubble.textContent = escapeHtml(message.content);

                div.appendChild(bubble);
                container.appendChild(div);
                container.scrollTop = container.scrollHeight;
            };

            if (conversationListContainer) {
                conversationListContainer.addEventListener('click', async (event) => {
                    const item = event.target.closest('.conversation-item');
                    if (!item) {
                        return;
                    }
                    const conversation = conversations.find(entry => entry.conversationId === item.dataset.conversationId);
                    if (!conversation) {
                        return;
                    }
                    await openConversation(conversation);
                });
            }

            const startConversation = async (targetUserId) => {
                if (!targetUserId) {
                    throw new Error('Target user id is required');
                }

                try {
                    const res = await fetch(`${API_BASE}/chat/conversations`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ targetUserId })
                    });
                    const payload = await res.json();
                    if (!res.ok) {
                        throw new Error(payload.message || 'Unable to start conversation');
                    }
                    const conversation = payload.data;
                    upsertConversation(conversation);
                    return conversation;
                } catch (error) {
                    if (error.name === 'TypeError') {
                        throw new Error('Network error, please try again later.');
                    }
                    throw error;
                }
            };

            const searchUserByEmail = async (email) => {
                if (!email) {
                    throw new Error('Please enter an email address');
                }

                try {
                    const res = await fetch(`${API_BASE}/chat/users/by-email?email=${encodeURIComponent(email)}`, {
                        credentials: 'include'
                    });
                    const payload = await res.json();
                    if (!res.ok) {
                        throw new Error(payload.message || 'User not found');
                    }
                    return payload.data;
                } catch (error) {
                    if (error.name === 'TypeError') {
                        throw new Error('Network error, please try again later.');
                    }
                    throw error;
                }
            };

            navLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    const targetId = this.getAttribute('href');
                    if (targetId && targetId.startsWith('#')) {
                        e.preventDefault();
                        switchTab(targetId);
                        if (history.pushState) {
                            history.pushState(null, null, targetId);
                        } else {
                            window.location.hash = targetId;
                        }
                    }
                });
            });

            const initialTab = window.location.hash || '#profile-details';
            switchTab(initialTab);

            // === TẢI DỮ LIỆU SỰ KIỆN TỪ API ===
            let allAppliedEvents = []; // Biến này sẽ giữ dữ liệu gốc

            try {
                const res = await fetch(`${API_BASE}/user/applied-events-this-month`, {
                    credentials: 'include'
                });

                if (res.ok) {
                    const result = await res.json();
                    allAppliedEvents = result.data || []; // Lấy mảng data từ response
                } else {
                    console.error("Failed to load applied events");
                }
            } catch (err) {
                console.error("Error fetching events:", err);
            }

            // === HÀM HELPER ĐỂ TẠO EVENT CARD HTML ===
            function createEventCardHtml(event) {
                const isOnline = event.onlineUrl && event.onlineUrl.trim() !== "";
                const eventType = isOnline ? "Online" : "Offline";
                // Nếu online, hiển thị URL. Nếu offline, hiển thị location.
                const locationText = isOnline ? event.onlineUrl : event.location;
                const icon = isOnline ? "fas fa-wifi" : "fas fa-map-marker-alt";
                const locationIcon = isOnline ? "fas fa-laptop" : "fas fa-map-marker-alt";
                const buttonText = isOnline ? "Join Event" : "View Ticket";

                // Format ngày tháng
                const eventDate = new Date(event.startTime).toLocaleString('en-US', {
                    month: 'short', day: 'numeric', year: 'numeric'
                });

                return `
            <div class="event-card"
                    data-title="${event.title}"
                    data-start="${event.startTime}"
                    data-end="${event.endTime}"
                    data-location="${locationText}"
                    data-type="${eventType}"
                    data-icon="${icon}">
                <img src="${event.cardImageUrl || 'https://via.placeholder.com/120x80/2c3e50/fff?text=Event'}" alt="Event" class="event-card-thumb">
                <div class="event-card-details">
                    <h4>${event.title}</h4>
                    <div class="event-card-meta">
                        <span><i class="far fa-calendar-alt"></i> ${eventDate}</span>
                        <span><i class="${locationIcon}"></i> ${locationText}</span>
                        <span><i class="${icon}"></i> ${eventType}</span>
                    </div>
                </div>
                <div class="event-card-actions">
                    <button class="btn btn-view-details">${buttonText}</button>
                </div>
            </div>
            `;
            }

            // === XỬ LÝ DỮ LIỆU CHO CÁC TAB ===

            // 1. Dữ liệu cho Lịch (Tab "All")
            const calendarEvents = allAppliedEvents.map(event => {
                const isOnline = event.onlineUrl && event.onlineUrl.trim() !== "";
                return {
                    title: event.title,
                    start: event.startTime,
                    end: event.endTime,
                    extendedProps: {
                        location: isOnline ? event.onlineUrl : event.location,
                        type: isOnline ? 'Online' : 'Offline',
                        icon: isOnline ? 'fas fa-wifi' : 'fas fa-map-marker-alt'
                    }
                };
            });

            // 2. Dữ liệu cho Tab "Offline"
            const offlineEventsContainer = document.querySelector("#tab-offline .event-list");
            const offlineEvents = allAppliedEvents.filter(e => !e.onlineUrl || e.onlineUrl.trim() === "");
            if (offlineEventsContainer) {
                if (offlineEvents.length > 0) {
                    offlineEventsContainer.innerHTML = offlineEvents.map(createEventCardHtml).join('');
                } else {
                    offlineEventsContainer.innerHTML = "<p style='text-align:center; padding: 20px;'>You have no applied offline events this month.</p>";
                }
            }

            // 3. Dữ liệu cho Tab "Online"
            const onlineEventsContainer = document.querySelector("#tab-online .event-list");
            const onlineEvents = allAppliedEvents.filter(e => e.onlineUrl && e.onlineUrl.trim() !== "");
            if (onlineEventsContainer) {
                if (onlineEvents.length > 0) {
                    onlineEventsContainer.innerHTML = onlineEvents.map(createEventCardHtml).join('');
                } else {
                    onlineEventsContainer.innerHTML = "<p style='text-align:center; padding: 20px;'>You have no applied online events this month.</p>";
                }
            }


            // === DỮ LIỆU SỰ KIỆN (THAY THẾ DỮ LIỆU MẪU) ===
            myEvents = calendarEvents; // Cập nhật dữ liệu cho lịch

            // === Code Lịch (Calendar) ===
            var calendarEl = document.getElementById('calendar');
            var calendar; // Khai báo calendar ở đây

            // === Code Modal ===
            const modal = document.getElementById('eventDetailModal');
            const closeModalBtn = document.getElementById('closeModalBtn');

            // --- Hàm mở Modal chung ---
            function openEventModal(title, start, end, location, type, icon) {
                var startTime = new Date(start).toLocaleString('en-US', {
                    hour: 'numeric', minute: 'numeric', hour12: true
                });
                var endTime = new Date(end).toLocaleString('en-US', {
                    hour: 'numeric', minute: 'numeric', hour12: true
                });
                var startDate = new Date(start).toLocaleString('en-US', {
                    year: 'numeric', month: 'long', day: 'numeric'
                });

                document.getElementById('modalEventTitle').textContent = title;
                document.getElementById('modalEventTime').textContent = `${startDate} (${startTime} - ${endTime})`;
                document.getElementById('modalEventLocation').textContent = location;
                document.getElementById('modalEventType').textContent = type;

                var locationIcon = document.getElementById('modalEventLocation').previousElementSibling;

                // Cập nhật icon cho Type và Location dựa trên logic online/offline
                var typeIconEl = document.getElementById('modalEventType').previousElementSibling;
                if (type === 'Online') {
                    locationIcon.className = 'fas fa-laptop';
                    typeIconEl.className = 'fas fa-wifi';
                } else {
                    locationIcon.className = 'fas fa-map-marker-alt';
                    typeIconEl.className = 'fas fa-globe';
                }

                modal.style.display = 'flex';
            }

            // --- Logic đóng modal ---
            if (modal && closeModalBtn) {
                closeModalBtn.addEventListener('click', () => { modal.style.display = 'none'; });
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) { modal.style.display = 'none'; }
                });
            }

            // === Code điều khiển Tab Lịch/List (All/Offline/Online) ===
            const tabButtons = document.querySelectorAll('#applied-events .tab-button');
            const tabPanels = document.querySelectorAll('#applied-events .tab-content-panel');

            tabButtons.forEach(button => {
                button.addEventListener('click', function () {
                    // Bỏ active
                    tabButtons.forEach(btn => btn.classList.remove('active'));
                    tabPanels.forEach(panel => panel.classList.remove('active'));

                    // Active cái mới
                    this.classList.add('active');
                    const targetPanelId = this.dataset.tab;
                    const targetPanel = document.getElementById(targetPanelId);
                    targetPanel.classList.add('active');

                    // **QUAN TRỌNG: Render lại lịch nếu là tab 'All'**
                    if (targetPanelId === 'tab-all') {
                        // Khởi tạo calendar nếu chưa có
                        if (!calendar) {
                            calendar = new FullCalendar.Calendar(calendarEl, {
                                initialView: 'dayGridMonth',
                                headerToolbar: {
                                    left: 'prev,next today',
                                    center: 'title',
                                    right: 'dayGridMonth,timeGridWeek'
                                },
                                events: myEvents, // Sử dụng dữ liệu động
                                eventClick: function (info) {
                                    info.jsEvent.preventDefault();
                                    openEventModal(
                                        info.event.title,
                                        info.event.start,
                                        info.event.end,
                                        info.event.extendedProps.location,
                                        info.event.extendedProps.type,
                                        info.event.extendedProps.icon
                                    );
                                }
                            });
                            calendar.render();
                        } else {
                            calendar.render(); // Chỉ render lại nếu đã tồn tại
                        }
                    }
                });
            });

            // === Code click cho Event List (Offline/Online) - SỬ DỤNG EVENT DELEGATION ===
            const eventListContainer = document.querySelector('.tab-content-container');
            if (eventListContainer) {
                eventListContainer.addEventListener('click', function (e) {
                    // Kiểm tra xem có click trúng nút .btn-view-details không
                    const viewButton = e.target.closest('.btn-view-details');

                    if (viewButton) {
                        const card = viewButton.closest('.event-card');
                        if (!card) return;

                        // Lấy dữ liệu từ data attributes
                        openEventModal(
                            card.dataset.title,
                            new Date(card.dataset.start), // Chuyển string thành Date
                            new Date(card.dataset.end),   // Chuyển string thành Date
                            card.dataset.location,
                            card.dataset.type,
                            card.dataset.icon
                        );
                    }
                });
            }

            // === Chat Widget Logic ===
            const triggerSearch = async () => {
                if (!chatSearchEmailInput) return;
                const email = chatSearchEmailInput.value.trim();
                if (!email) {
                    renderSearchFeedback('<span class="error-text">Please enter an email address.</span>', true);
                    return;
                }

                renderSearchFeedback('<span>Searching...</span>');
                try {
                    const user = await searchUserByEmail(email);
                    renderSearchFeedback(
                        `<div class="chat-search-result">
                            <div class="chat-search-user">
                                <span class="name">${escapeHtml(user.fullName)}</span>
                                <span class="email">${escapeHtml(user.email)}</span>
                            </div>
                            <button type="button" class="btn btn-start-chat" data-user-id="${user.userId}"><i class="fas fa-comment-dots"></i> Start chat</button>
                        </div>`
                    );
                } catch (error) {
                    renderSearchFeedback(`<span class="error-text">${escapeHtml(error.message || 'User not found')}</span>`, true);
                }
            };

            if (chatSearchButton) {
                chatSearchButton.addEventListener('click', triggerSearch);
            }

            if (chatSearchEmailInput) {
                chatSearchEmailInput.addEventListener('keydown', async (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        await triggerSearch();
                    }
                });
            }

            if (chatSearchFeedback) {
                chatSearchFeedback.addEventListener('click', async (e) => {
                    const startButton = e.target.closest('.btn-start-chat');
                    if (!startButton) return;
                    const targetUserId = startButton.dataset.userId;
                    try {
                        const conversation = await startConversation(targetUserId);
                        await openConversation(conversation);
                        if (chatSearchEmailInput) {
                            chatSearchEmailInput.value = '';
                        }
                        renderSearchFeedback('');
                    } catch (error) {
                        renderSearchFeedback(`<span class="error-text">${escapeHtml(error.message)}</span>`, true);
                    }
                });
            }

            if (closeChatBtn && chatWidget) {
                closeChatBtn.addEventListener('click', async () => {
                    if (activeConversationId) {
                        await leaveConversationGroup(activeConversationId);
                    }
                    activeConversationId = null;
                    activeChatPartner = null;
                    renderedMessageIds.clear();
                    renderConversationList(conversations);
                    if (chatMessagesContainer) {
                        chatMessagesContainer.innerHTML = '';
                    }
                    if (chatMessageInput) {
                        chatMessageInput.value = '';
                    }
                    chatWidget.style.display = 'none';
                });
            }

            // Close messenger chat
            const closeMessengerChat = document.getElementById('closeMessengerChat');
            if (closeMessengerChat) {
                closeMessengerChat.addEventListener('click', async () => {
                    if (activeConversationId) {
                        await leaveConversationGroup(activeConversationId);
                    }
                    activeConversationId = null;
                    activeChatPartner = null;
                    renderedMessageIds.clear();
                    renderConversationList(conversations);

                    const messengerPlaceholder = document.getElementById('messengerPlaceholder');
                    const messengerChatView = document.getElementById('messengerChatView');
                    const messengerMessages = document.getElementById('messengerMessages');
                    const messengerMessageInput = document.getElementById('messengerMessageInput');

                    if (messengerPlaceholder) messengerPlaceholder.style.display = 'flex';
                    if (messengerChatView) messengerChatView.style.display = 'none';
                    if (messengerMessages) messengerMessages.innerHTML = '';
                    if (messengerMessageInput) messengerMessageInput.value = '';
                });
            }

            // Tab switching
            const messengerTabs = document.querySelectorAll('.messenger-tab');
            const messengerTabPanels = document.querySelectorAll('.messenger-tab-panel');
            messengerTabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    const targetTab = tab.dataset.tab;
                    messengerTabs.forEach(t => t.classList.remove('active'));
                    messengerTabPanels.forEach(p => p.classList.remove('active'));
                    tab.classList.add('active');
                    const targetPanel = document.getElementById(targetTab + 'Panel');
                    if (targetPanel) {
                        targetPanel.classList.add('active');
                    }
                });
            });

            // Messenger message form
            const messengerMessageForm = document.getElementById('messengerMessageForm');
            const messengerMessageInput = document.getElementById('messengerMessageInput');
            if (messengerMessageForm && messengerMessageInput) {
                messengerMessageForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const content = messengerMessageInput.value.trim();
                    if (!content || !activeConversationId) {
                        return;
                    }

                    try {
                        const res = await fetch(`${API_BASE}/chat/conversations/${activeConversationId}/messages`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ content })
                        });
                        const payload = await res.json();
                        if (!res.ok) {
                            throw new Error(payload.message || 'Failed to send message');
                        }
                        messengerMessageInput.value = '';
                        const serverMessage = { ...payload.data };
                        if (!serverMessage.senderId && currentUserId) {
                            serverMessage.senderId = currentUserId;
                        }
                        const msgData = { ...serverMessage, isMine: true };
                        if (!renderedMessageIds.has(msgData.messageId)) {
                            renderedMessageIds.add(msgData.messageId);
                            appendMessageToMessenger(msgData);
                        }
                        updateConversationPreviewFromMessage(serverMessage);
                    } catch (error) {
                        console.error(error);
                        alert(error.message || 'Failed to send message');
                    }
                });
            }

            if (chatMessageForm && chatMessageInput) {
                chatMessageForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const content = chatMessageInput.value.trim();
                    if (!content || !activeConversationId) {
                        return;
                    }

                    try {
                        const res = await fetch(`${API_BASE}/chat/conversations/${activeConversationId}/messages`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({ content })
                        });
                        const payload = await res.json();
                        if (!res.ok) {
                            throw new Error(payload.message || 'Failed to send message');
                        }
                        chatMessageInput.value = '';
                        const serverMessage = { ...payload.data };
                        if (!serverMessage.senderId && currentUserId) {
                            serverMessage.senderId = currentUserId;
                        }
                        appendMessage({ ...serverMessage, isMine: true });
                        updateConversationPreviewFromMessage(serverMessage);
                    } catch (error) {
                        console.error(error);
                        alert(error.message || 'Failed to send message');
                    }
                });
            }


            // --- Tự động kích hoạt tab "All" và render lịch lần đầu ---
            // (Nếu tab "All" là active mặc định)
            if (document.querySelector('#tab-all').classList.contains('active')) {
                if (calendarEl) { // Đảm bảo calendarEl tồn tại
                    calendar = new FullCalendar.Calendar(calendarEl, {
                        initialView: 'dayGridMonth',
                        headerToolbar: {
                            left: 'prev,next today',
                            center: 'title',
                            right: 'dayGridMonth,timeGridWeek'
                        },
                        events: myEvents, // Sử dụng dữ liệu động
                        eventClick: function (info) {
                            info.jsEvent.preventDefault();
                            openEventModal(
                                info.event.title,
                                info.event.start,
                                info.event.end,
                                info.event.extendedProps.location,
                                info.event.extendedProps.type,
                                info.event.extendedProps.icon
                            );
                        }
                    });
                    calendar.render();
                }
            }
        });
