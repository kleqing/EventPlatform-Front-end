@{
    ViewData["Title"] = "Thanh toán";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="/css/Payment.css" />
</head>
<body>

    <section class="checkout-banner">
        <div class="container">
            <div class="event-banner-info">
                <h2>DOMIE HOMIE - 2025 Dương Domic Fan Meeting in DANANG</h2>
                <p><i class="fas fa-calendar-alt"></i> 19:00 - 21:00, 23 Tháng 11, 2025</p>
                <p><i class="fas fa-map-marker-alt"></i> Nhà Hát Trưng Vương</p>
            </div>
            <div class="countdown-box">
                <p>Hoàn tất đặt vé trong</p>
                <div class="countdown-timer">
                    <span id="countdown-minutes">11</span>
                    <span>:</span>
                    <span id="countdown-seconds">05</span>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="checkout-layout">

            <main class="checkout-main">

                <section id="step-questions" class="checkout-step active">
                    <div class="card">
                        <div class="card-header">Bảng Câu Hỏi</div>
                        <div class="form-check">
                            <input type="checkbox" id="agreeTerms" checked>
                            <label for="agreeTerms">Tôi đồng ý cho Ticketbox & BTC sử dụng thông tin đặt vé...</label>
                        </div>
                        <hr style="border: 0; border-top: 1px solid var(--border-color); margin: 20px 0;">
                        <form id="questionsForm">
                            <div class="form-group">
                                <input type="text" id="q_fullName" value="Trần Hữu Thành" placeholder=" " required>
                                <label for="q_fullName">Họ & Tên của bạn?</label>
                            </div>
                            <div class="form-group">
                                <input type="text" id="q_cccd" value="048099000123" placeholder=" " required>
                                <label for="q_cccd">Số CCCD người tham dự?</label>
                            </div>
                            <div class="form-group">
                                <input type="text" id="q_address" value="123 Đường Nguyễn Văn Linh, Q. Hải Châu, TP. Đà Nẵng" placeholder=" " required>
                                <label for="q_address">Địa chỉ của bạn?</label>
                            </div>
                            <div class="form-grid">
                                <div class="form-group">
                                    <input type="email" id="q_email" value="thanhthde180390@fpt.edu.vn" placeholder=" " required>
                                    <label for="q_email">Email của bạn?</label>
                                </div>
                                <div class="form-group">
                                    <input type="text" id="q_phone" value="0905123456" placeholder=" " required>
                                    <label for="q_phone">Số điện thoại của bạn?</label>
                                </div>
                            </div>
                        </form>
                    </div>
                </section>

                <section id="step-payment" class="checkout-step">
                    <div class="card">
                        <div class="card-header">Thanh Toán</div>
                        <div class="info-box">
                            <div class="info-box-header">
                                <h5>Thông tin nhận vé</h5>
                                <button class="btn-link" id="btnEditAttendee">Chỉnh sửa</button>
                            </div>
                            <p>
                                Vé điện tử sẽ được hiển thị...<br>
                                <span id="attendeeEmailDisplay">thanhthde180390@fpt.edu.vn</span>
                            </p>
                        </div>
                        <div class="info-box">
                            <div class="info-box-header">
                                <h5>Mã khuyến mãi</h5>
                                <a href="#" class="btn-link">Chọn voucher</a>
                            </div>
                            <form class="promo-form">
                                <input type="text" placeholder="Nhập mã khuyến mãi...">
                                <button type="button" class="btn btn-secondary">Áp dụng</button>
                            </form>
                        </div>
                        <div class="info-box">
                            <h5>Phương thức thanh toán</h5>
                            <ul class="payment-method-list">
                                <li class="payment-method selected">
                                    <input type="radio" name="payment" id="pay_vnpay" checked>
                                    <img src="https://via.placeholder.com/30x30/005baa/fff?text=V" alt="VNPay">
                                    <label for="pay_vnpay">VNPAY/Ứng dụng ngân hàng</label>
                                </li>
                                <li class="payment-method">
                                    <input type="radio" name="payment" id="pay_vietqr">
                                    <img src="https://via.placeholder.com/30x30/e30613/fff?text=Q" alt="VietQR">
                                    <label for="pay_vietqr">VietQR</label>
                                </li>
                                <li class="payment-method">
                                    <input type="radio" name="payment" id="pay_shopee">
                                    <img src="https://via.placeholder.com/30x30/ee4d2d/fff?text=S" alt="ShopeePay">
                                    <label for="pay_shopee">ShopeePay</label>
                                </li>
                            </ul>
                        </div>
                    </div>
                </section>
            </main>

            <aside class="checkout-sidebar">
                <div class="card">
                    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                        Thông tin đặt vé
                        <button class="btn-link" id="btnChooseTickets">Chọn lại vé</button>
                    </div>
                    <div class="summary-row">
                        <span class="label">Loại vé</span>
                        <span class="value">Số lượng</span>
                    </div>
                    <div class="summary-row ticket-details">
                        <span class="label">CAT 2<span class="seat">E-28</span><span class="seat">E-24</span></span>
                        <span class="value">02</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">1,500,000 đ</span>
                        <span class="value">1,500,000 đ</span>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">Thông tin đơn hàng</div>
                    <div class="summary-row">
                        <span class="label">Tạm tính (2 vé)</span>
                        <span class="value">3,000,000 đ</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Phí tiện ích</span>
                        <span class="value">0 đ</span>
                    </div>
                    <div class="summary-row total">
                        <span class="label">Tổng tiền</span>
                        <span class="value" style="color: var(--primary-color);">3,000,000 đ</span>
                    </div>
                    <button class="btn btn-submit-order" id="btnMainAction">
                        Tiếp tục <i class="fas fa-arrow-right"></i>
                    </button>
                    <p class="sidebar-note">
                        Bằng việc nhấn Tiếp tục, bạn đồng ý với <a href="#">Siêu Điều Khoản Chung</a>.
                    </p>
                </div>
            </aside>
        </div>
    </div>

    <div id="attendeeInfoModal" class="modal-overlay">
        <div class="modal-content">
            <button id="closeAttendeeModal" class="modal-close-btn">&times;</button>
            <h4>Cập nhật thông tin nhận vé</h4>
            <form>
                <div class="form-group">
                    <input type="text" id="modal_name" value="Trần Hữu Thành" placeholder=" " required>
                    <label for="modal_name">Tên người nhận</label>
                </div>
                <div class="form-group">
                    <input type="text" id="modal_phone" value="0905123456" placeholder=" " required>
                    <label for="modal_phone">Số điện thoại</label>
                </div>
                <div class="form-group">
                    <input type="email" id="modal_email" value="thanhthde180390@fpt.edu.vn" placeholder=" " required>
                    <label for="modal_email">Email</label>
                </div>
                <div class="form-group">
                    <select id="modal_city" required>
                        <option value="" disabled></option>
                        <option value="danang" selected>Đà Nẵng</option>
                        <option value="hanoi">Hà Nội</option>
                        <option value="hcm">TP. Hồ Chí Minh</option>
                    </select>
                    <label for="modal_city">Tỉnh/Thành Phố</label>
                </div>
                <div class="form-grid">
                    <div class="form-group">
                        <select id="modal_district" required>
                            <option value="" disabled></option>
                            <option value="camle" selected>Cẩm Lệ</option>
                            <option value="haichau">Hải Châu</option>
                        </select>
                        <label for="modal_district">Quận/Huyện</label>
                    </div>
                    <div class="form-group">
                        <select id="modal_ward" required>
                            <option value="" disabled></option>
                            <option value="khuetrung" selected>Khuê Trung</option>
                            <option value="hoaxuan">Hòa Xuân</option>
                        </select>
                        <label for="modal_ward">Phường/Xã</label>
                    </div>
                </div>
                <div class="form-group">
                    <input type="text" id="modal_address" value="123 Đường Nguyễn Văn Linh, Q. Hải Châu, TP. Đà Nẵng" placeholder=" ">
                    <label for="modal_address">Địa chỉ</label>
                </div>
                <div class="form-group">
                    <input type="text" id="modal_notes" placeholder=" ">
                    <label for="modal_notes">Lưu ý</label>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancelAttendeeUpdate">Hủy bỏ</button>
                    <button type="submit" class="btn" id="saveAttendeeUpdate">Xác nhận</button>
                </div>
            </form>
        </div>
    </div>

    <div id="chooseTicketModal" class="modal-overlay">
        <div class="modal-content">
            <button id="closeTicketModal" class="modal-close-btn">&times;</button>
            <h4>Chọn lại vé</h4>
            <div class="modal-body">
                <ul class="ticket-selection-list">
                    <li class="ticket-selection-item">
                        <div>
                            <h5>CAT 2</h5>
                            <p>Thời gian bán: 01/11 - 22/11</p>
                            <span class="ticket-price">1,500,000 đ</span>
                        </div>
                        <div class="quantity-selector">
                            <button class="quantity-btn quantity-btn-minus" data-action="decrease">-</button>
                            <input class="quantity-input" type="number" value="2" min="0" max="10" readonly>
                            <button class="quantity-btn quantity-btn-plus" data-action="increase">+</button>
                        </div>
                    </li>
                    <li class="ticket-selection-item">
                        <div>
                            <h5>CAT 5 (Free)</h5>
                            <p>Số lượng còn lại: 50/100</p>
                            <span class="ticket-price">Miễn phí</span>
                        </div>
                        <div class="quantity-selector">
                            <button class="quantity-btn quantity-btn-minus" data-action="decrease">-</button>
                            <input class="quantity-input" type="number" value="0" min="0" max="5" readonly>
                            <button class="quantity-btn quantity-btn-plus" data-action="increase">+</button>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" id="confirmTicketSelection">Xác nhận</button>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {


            const stepQuestions = document.getElementById('step-questions');
            const stepPayment = document.getElementById('step-payment');
            const btnMainAction = document.getElementById('btnMainAction');
            const btnChooseTickets = document.getElementById('btnChooseTickets');
            let currentStep = 1;

            btnMainAction.addEventListener('click', function () {
                if (currentStep === 1) {


                    stepQuestions.classList.remove('active');
                    stepPayment.classList.add('active');
                    btnMainAction.innerHTML = 'Thanh toán <i class="fas fa-lock"></i>';
                    currentStep = 2;
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } else {
                    alert('Xử lý thanh toán...');
                }
            });

            const attendeeModal = document.getElementById('attendeeInfoModal');
            const btnEditAttendee = document.getElementById('btnEditAttendee');
            const closeAttendeeModal = document.getElementById('closeAttendeeModal');
            const cancelAttendeeUpdate = document.getElementById('cancelAttendeeUpdate');

            btnEditAttendee.addEventListener('click', () => attendeeModal.classList.add('show'));
            closeAttendeeModal.addEventListener('click', () => attendeeModal.classList.remove('show'));
            cancelAttendeeUpdate.addEventListener('click', () => attendeeModal.classList.remove('show'));
            attendeeModal.addEventListener('click', function (e) {
                if (e.target === attendeeModal) attendeeModal.classList.remove('show');
            });

            const chooseTicketModal = document.getElementById('chooseTicketModal');
            const btnOpenChooseTicket = document.getElementById('btnChooseTickets');
            const btnCloseTicketModal = document.getElementById('closeTicketModal');
            const btnConfirmTickets = document.getElementById('confirmTicketSelection');
            const ticketSelectionList = document.querySelector('.ticket-selection-list');

            btnOpenChooseTicket.addEventListener('click', function (e) {
                e.preventDefault();
                chooseTicketModal.classList.add('show');
            });

            btnCloseTicketModal.addEventListener('click', () => chooseTicketModal.classList.remove('show'));
            btnConfirmTickets.addEventListener('click', () => {
                console.log('Cập nhật giỏ hàng...');
                chooseTicketModal.classList.remove('show');
            });
            chooseTicketModal.addEventListener('click', function (e) {
                if (e.target === chooseTicketModal) chooseTicketModal.classList.remove('show');
            });

            if (ticketSelectionList) {
                ticketSelectionList.addEventListener('click', function (e) {
                    const button = e.target.closest('.quantity-btn');
                    if (!button) return;

                    const action = button.dataset.action;
                    const input = button.parentElement.querySelector('.quantity-input');
                    let currentValue = parseInt(input.value);
                    const maxValue = parseInt(input.max);
                    const minValue = parseInt(input.min);

                    if (action === 'increase' && currentValue < maxValue) {
                        input.value = currentValue + 1;
                    } else if (action === 'decrease' && currentValue > minValue) {
                        input.value = currentValue - 1;
                    }

                    const currentVal = parseInt(input.value);
                    button.parentElement.querySelector('.quantity-btn-minus').disabled = (currentVal <= minValue);
                    button.parentElement.querySelector('.quantity-btn-plus').disabled = (currentVal >= maxValue);
                });
            }

            let timeInSeconds = 11 * 60 + 5;
            const minutesEl = document.getElementById('countdown-minutes');
            const secondsEl = document.getElementById('countdown-seconds');

            const timerInterval = setInterval(() => {
                if (timeInSeconds <= 0) {
                    clearInterval(timerInterval);
                    alert('Đã hết thời gian đặt vé!');
                    btnMainAction.disabled = true;
                    btnMainAction.textContent = "Đã hết hạn";
                    return;
                }
                timeInSeconds--;
                let min = Math.floor(timeInSeconds / 60);
                let sec = timeInSeconds % 60;
                minutesEl.textContent = min.toString().padStart(2, '0');
                secondsEl.textContent = sec.toString().padStart(2, '0');
            }, 1000);

            const paymentMethods = document.querySelectorAll('.payment-method');
            paymentMethods.forEach(method => {
                method.addEventListener('click', () => {
                    paymentMethods.forEach(m => m.classList.remove('selected'));
                    method.classList.add('selected');
                    method.querySelector('input[type="radio"]').checked = true;
                });
            });
        });
    </script>
</body>

</html>
