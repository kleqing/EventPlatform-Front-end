            async function loadCategories() {
                try {
                    const res = await fetch('https://eventplatform.runasp.net/api/events/getalleventcategories', {
                        method: 'GET',
                    });

                    if (!res.ok) {
                        throw new Error("Không thể tải danh sách category");
                    }

                    const categories = await res.json();

                    const select = document.getElementById("eventCategory");

                    // Xóa hết option cũ trừ dòng đầu
                    select.innerHTML = '<option value="" disabled selected>Select a category...</option>';

                    // Thêm từng category vào select
                    categories.forEach(cat => {
                        const option = document.createElement("option");
                        option.value = cat.categoryId;
                        option.textContent = cat.name;
                        select.appendChild(option);
                    });

                } catch (err) {
                    console.error("Lỗi khi tải categories:", err);
                }
            }

            loadCategories();

            async function createEvent() {
                // Tạo đối tượng CreateEventDto từ dữ liệu người dùng nhập
                const createEventDto = {
                    title: document.getElementById("eventTitle").value,
                    description: document.getElementById("eventDescription").value,
                    startTime: document.getElementById("startTime").value,
                    endTime: document.getElementById("endTime").value,
                    eventType: document.getElementById("eventType").value,
                    eventStatus: document.getElementById("eventStatus").value,
                    location: "",
                    coverImageUrl: document.getElementById("coverImage").value,
                    cardImageUrl: document.getElementById("cardImage").value,
                    organizerName: document.getElementById("organizerName").value,
                    organizerInfo: document.getElementById("organizerInfo").value,
                    organizerLogoUrl: document.getElementById("organizerLogo").value,
                    venueName: document.getElementById("venueName").value,
                    addressStreet: document.getElementById("addressStreet").value,
                    addressWard: document.getElementById("addressWard").value,
                    addressDistrict: document.getElementById("addressDistrict").value,
                    addressCity: document.getElementById("addressCity").value,
                    categoryId: document.getElementById("eventCategory").value,
                };


                // Gộp thành request cuối
                const requestData = {
                    createEventDto,
                    createTicketTypeList: [...ticketMap.values()]
                };
                document.getElementById("loadingOverlay").style.display = "flex";
                try {
                    const response = await fetch('https://eventplatform.runasp.net/api/events/create', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify(requestData)
                    });

                    if (response.ok) {
                        showResultModal(true, "Sự kiện đã được tạo thành công!");
                        setTimeout(() => {
                            window.location.href = "/";
                        }, 2000);
                        // 
                    } else {
                        const errorText = await response.text();
                        showResultModal(false, response.text());
                    }
                } catch (err) {
                    showResultModal(false, "Vui lòng kiểm tra lại thông tin và thử lại.");
                    console.error("Lỗi:", err);
                }
                document.getElementById("loadingOverlay").style.display = "none";
            }
        });
    </script>
