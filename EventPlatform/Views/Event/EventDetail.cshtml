    <div class="container comments-section">
        <div class="comments-header">
            <h3 id="feedback-count">Feedbacks (0)</h3>
            <div class="comments-pagination">
                <a href="javascript:void(0)" id="prev-comment-btn" style="display:none;"> <i class="fas fa-chevron-left"></i> Previous</a>
                <a href="javascript:void(0)" id="next-comment-btn" style="display:none; margin-left: 10px;">Next <i class="fas fa-chevron-right"></i></a>
