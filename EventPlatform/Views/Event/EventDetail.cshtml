</html>

<script>
    document.addEventListener('DOMContentLoaded', async () => {
        const loadingSpinner = document.getElementById('loading-spinner');
        const contentContainer = document.getElementById('event-detail-container');
        const API_BASE_URL = "https://localhost:7063";

        // --- Cấu hình Pagination ---
        let allComments = [];   // Chứa toàn bộ comment lấy từ API
        let currentPage = 1;
        const commentsPerPage = 5; // Số comment mỗi trang

        try {
            const params = new URLSearchParams(window.location.search);
            const eventId = params.get('id');

            if (!eventId) throw new Error("Event ID not found in URL.");

            loadCurrentUser();

            // 1. Load thông tin Event (Header, Description...)
            await loadEventDetails(API_BASE_URL, eventId);

            // 2. Load danh sách Comments riêng biệt (để xử lý phân trang dễ hơn)
            await loadAndRenderComments(API_BASE_URL, eventId);

            // 3. Khởi tạo chức năng Rating (Fix lỗi không click được)
            setupRatingUI();

            // 4. Khởi tạo chức năng Submit Feedback (Dùng LocalStorage)
            setupSubmitFeedback(API_BASE_URL, eventId);

            // Hiển thị giao diện sau khi load xong
            loadingSpinner.style.display = 'none';
            contentContainer.style.display = 'grid';

        } catch (error) {
            console.error(error);
            loadingSpinner.innerHTML = `<p style="color: red;">${error.message}</p>`;
        }

        function loadCurrentUser() {
            const userJson = localStorage.getItem('user');
            const previewBox = document.getElementById('user-preview-box');
            const avatarImg = document.getElementById('current-user-img');
            const nameSpan = document.getElementById('current-user-name');

            if (userJson) {
                try {
                    const user = JSON.parse(userJson);

                    // 1. Hiển thị box
                    previewBox.style.display = 'flex';

                    // 2. Set Avatar (Lấy key 'avatarUrl' từ JSON bạn cung cấp)
                    if (user.avatarUrl) {
                        avatarImg.src = user.avatarUrl;
                    } else {
                        // Nếu không có avatar thì dùng ảnh mặc định
                        avatarImg.src = 'https://via.placeholder.com/50?text=User';
                    }

                    // 3. Set Tên (Lấy key 'fullName')
                    if (user.fullName) {
                        nameSpan.textContent = user.fullName;
                    } else {
                        nameSpan.textContent = user.email || 'User';
                    }

                } catch (e) {
                    console.error("Lỗi parse user localstorage", e);
                }
            } else {
                // Nếu chưa đăng nhập thì ẩn box preview đi
                previewBox.style.display = 'none';
            }
        }

        // ---------------------------------------------------------
        // HÀM: Load chi tiết sự kiện
        // ---------------------------------------------------------
        async function loadEventDetails(baseUrl, id) {
            const response = await fetch(`${baseUrl}/api/Events/${id}`);
            if (!response.ok) throw new Error("Failed to load event data.");
            const event = await response.json();
            populatePage(event);
        }

        // ---------------------------------------------------------
        // HÀM: Load và Phân trang Comments
        // ---------------------------------------------------------
        async function loadAndRenderComments(baseUrl, id) {
            try {
                const response = await fetch(`${baseUrl}/api/events/listcomments/${id}`);
                if (response.ok) {
                    const resData = await response.json();
                    // API trả về format { data: [...] }, ta lấy phần data
                    allComments = resData.data || [];

                    // Cập nhật số lượng tổng
                    document.getElementById('feedback-count').textContent = `Feedbacks (${allComments.length})`;

                    // Render trang 1
                    currentPage = 1;
                    renderCommentsPage(currentPage);
                    setupPaginationControls();
                }
            } catch (err) {
                console.error("Error loading comments:", err);
            }
        }

        function renderCommentsPage(page) {
            const listContainer = document.getElementById('comments-list-container');
            listContainer.innerHTML = '';

            if (allComments.length === 0) {
                listContainer.innerHTML = '<p>Be the first to leave a feedback!</p>';
                return;
            }

            // Logic cắt mảng (Slice)
            const startIndex = (page - 1) * commentsPerPage;
            const endIndex = startIndex + commentsPerPage;
            const commentsToDisplay = allComments.slice(startIndex, endIndex);
            
            commentsToDisplay.forEach(fb => {
                // Format ngày tháng
                const fbDate = new Date(fb.submittedAt).toLocaleString('en-US');

                // Render sao của user
                let starsHtml = '';
                for(let i=0; i<5; i++) {
                    starsHtml += `<i class="${i < fb.rating ? 'fas' : 'far'} fa-star" style="color: #ffc107; font-size: 12px;"></i>`;
                }
                const userAvatar = fb.avatarUrl || 'https://via.placeholder.com/60x60?text=User';


                const html = `
                    <div class="comment-item">
                        <img class="comment-avatar" src="${userAvatar}" alt="${fb.userName}" />
                        <div class="comment-content">
                            <div class="author">${fb.userName || 'Anonymous'} ${starsHtml}</div>
                            <div class="date">${fbDate}</div>
                            <p>${fb.comment}</p>
                        </div>
                    </div>
                `;
                listContainer.insertAdjacentHTML('beforeend', html);
            });

            updatePaginationButtons();
        }

        function setupPaginationControls() {
            const prevBtn = document.getElementById('prev-comment-btn');
            const nextBtn = document.getElementById('next-comment-btn');

            prevBtn.addEventListener('click', () => {
                if (currentPage > 1) {
                    currentPage--;
                    renderCommentsPage(currentPage);
                }
            });

            nextBtn.addEventListener('click', () => {
                const totalPages = Math.ceil(allComments.length / commentsPerPage);
                if (currentPage < totalPages) {
                    currentPage++;
                    renderCommentsPage(currentPage);
                }
            });
        }

        function updatePaginationButtons() {
            const prevBtn = document.getElementById('prev-comment-btn');
            const nextBtn = document.getElementById('next-comment-btn');
            const totalPages = Math.ceil(allComments.length / commentsPerPage);

            // Ẩn hiện nút Previous
            prevBtn.style.display = (currentPage > 1) ? 'inline-block' : 'none';

            // Ẩn hiện nút Next
            nextBtn.style.display = (currentPage < totalPages) ? 'inline-block' : 'none';
        }

        // ---------------------------------------------------------
        // HÀM: Xử lý UI Rating (Fix lỗi cũ)
        // ---------------------------------------------------------
        function setupRatingUI() {
            const stars = document.querySelectorAll('#star-rating-box i');
            const ratingInput = document.getElementById('rating-value');
            let currentRating = 0;

            stars.forEach(star => {
                // Hover vào
                star.addEventListener('mouseover', function() {
                    const value = parseInt(this.getAttribute('data-value'));
                    highlightStars(value, 'hover');
                });

                // Hover ra
                star.addEventListener('mouseout', function() {
                    resetStars(); // Xóa class hover
                    if (currentRating > 0) highlightStars(currentRating, 'active'); // Trả lại màu đã chọn
                });

                // Click
                star.addEventListener('click', function() {
                    currentRating = parseInt(this.getAttribute('data-value'));
                    ratingInput.value = currentRating;

                    // Xóa hết active cũ và set active mới
                    stars.forEach(s => s.classList.remove('active'));
                    highlightStars(currentRating, 'active');
                });
            });

            function highlightStars(count, className) {
                stars.forEach(s => {
                    if (parseInt(s.getAttribute('data-value')) <= count) {
                        s.classList.add(className);
                    }
                });
            }

            function resetStars() {
                stars.forEach(s => s.classList.remove('hover'));
            }
        }

        // ---------------------------------------------------------
        // HÀM: Submit Feedback (Lấy user từ LocalStorage)
        // ---------------------------------------------------------
        function setupSubmitFeedback(baseUrl, eventId) {
            const feedbackForm = document.getElementById('feedback-form');

            feedbackForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                // 1. Lấy thông tin User & Token từ LocalStorage
                const userJson = localStorage.getItem('user');

                // Kiểm tra nếu chưa đăng nhập
                if (!userJson) {
                    alert("Please login to leave a comment!");
                    // window.location.href = '/Login'; // Uncomment nếu muốn chuyển trang
                    return;
                }

                const userObj = JSON.parse(userJson);

                // --- QUAN TRỌNG: Lấy Token ---
                // Bạn kiểm tra xem Token bạn lưu ở đâu? 
                // Trường hợp 1: Lưu riêng key 'token' -> localStorage.getItem('token')
                // Trường hợp 2: Lưu trong object user -> userObj.token
                // Dưới đây mình thử lấy cả 2 trường hợp:
                const token = localStorage.getItem('token') || userObj.token || userObj.accessToken;

                // Lấy Email
                const userEmail = userObj.email || userObj.emailAddress || userObj.Email;

                if(!userEmail) {
                    alert("Cannot find user email info. Please login again.");
                    return;
                }

                // 2. Validate Form
                const submitBtn = document.getElementById('btn-submit-feedback');
                const comment = document.getElementById('feedback-comment').value;
                const rating = parseInt(document.getElementById('rating-value').value);
                const errorMsg = document.getElementById('rating-error');

                if (rating === 0) {
                    errorMsg.style.display = 'block';
                    return;
                }
                errorMsg.style.display = 'none';

                // 3. Chuẩn bị Payload
                const payload = {
                    eventId: parseInt(eventId), // Đảm bảo là số integer
                    userEmail: userEmail,
                    rating: rating,
                    comment: comment,
                    submittedAt: new Date().toISOString()
                };

                // 4. Gửi API
                try {
                    submitBtn.disabled = true;
                    submitBtn.textContent = "Sending...";

                    const response = await fetch(`${baseUrl}/api/events/createcomment`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        credentials: 'include', // Gửi kèm cookie nếu có
                        body: JSON.stringify(payload)
                    });

                    // --- FIX LỖI JSON SYNTAX ---
                    // Kiểm tra status trước khi parse JSON
                    if (response.status === 401) {
                        throw new Error("Unauthorized: Your session may have expired. Please login again.");
                    }

                    if (!response.ok) {
                        // Cố đọc lỗi từ server nếu có, nếu không thì báo lỗi chung
                        const errorText = await response.text();
                        throw new Error(`Server Error (${response.status}): ${errorText}`);
                    }

                    // Nếu response OK thì mới parse JSON
                    const resData = await response.json();

                    if (resData.success) {
                        alert('Thank you! Your comment has been posted.');

                        // Reset form
                        feedbackForm.reset();
                        document.getElementById('rating-value').value = 0;
                        document.querySelectorAll('#star-rating-box i').forEach(s => s.classList.remove('active'));

                        // Reload lại list comments
                        // Gọi lại hàm load comment từ scope cha (cần đảm bảo hàm này truy cập được)
                        // Cách đơn giản nhất là reload trang hoặc gọi lại logic load comment nếu biến scope cho phép
                        location.reload();
                    } else {
                        alert('Failed: ' + (resData.message || 'Unknown error'));
                    }

                } catch (error) {
                    console.error("Submit Error:", error);
                    alert(error.message);
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Submit Feedback";
                }
            });
        }

    function populatePage(event) {
        // Định dạng ngày
        const eventDate = new Date(event.startTime).toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric'
        });
        const bookBtn = document.querySelector('.book-event-form .btn-primary');
        if (bookBtn) {
            // Khi bấm sẽ nhảy qua /Payment/BookingTickets kèm theo id sự kiện
            bookBtn.href = `/Payment/BookingTickets?eventId=${event.eventId}`;

            // Xóa thuộc tính asp-action/controller cũ để tránh xung đột (vì ta xử lý bằng JS)
            bookBtn.removeAttribute('asp-controller');
            bookBtn.removeAttribute('asp-action');
        }

            document.querySelector('.event-main-image').src = event.coverImageUrl || 'https://via.placeholder.com/800x400';
            document.getElementById('event-meta-date').innerHTML = `<i class="far fa-calendar-alt"></i> ${eventDate}`;
            document.getElementById('event-meta-seats').innerHTML = `<span class="seat-badge"><i class="fas fa-chair"></i> ${event.totalSeats} Seat</span>`;
            document.getElementById('event-meta-location').innerHTML = `<i class="fas fa-map-marker-alt"></i> ${event.location || 'Online'}`;
            document.getElementById('event-detail-category').textContent = event.categoryName || 'N/A';
            document.getElementById('event-detail-speaker-count').textContent = `${event.speakers.length} Speaker(s)`;

            // Rating tổng quan
            const ratingStars = Math.round(event.ratingAverage);
            let starsHtml = '';
            for(let i = 0; i < 5; i++) {
                starsHtml += `<i class="${i < ratingStars ? 'fas' : 'far'} fa-star"></i>`;
            }
            document.getElementById('event-detail-rating').innerHTML = `${starsHtml} (${event.ratingCount})`;

            document.getElementById('event-title').textContent = event.title;
            document.getElementById('event-description-html').innerHTML = event.description;

            // Render Speakers
            const speakerGrid = document.getElementById('speaker-grid-container');
            speakerGrid.innerHTML = '';
            if(event.speakers.length > 0) {
                event.speakers.forEach(speaker => {
                    speakerGrid.insertAdjacentHTML('beforeend', `
                    <div class="speaker-card-full">
                        <img src="${speaker.avatarUrl || 'https://via.placeholder.com/80x80'}" alt="${speaker.fullName}" />
                        <div>
                            <div class="name">${speaker.fullName}</div>
                            <div class="role">${speaker.jobTitle || 'Speaker'}</div>
                        </div>
                    </div>
                `);
                });
            } else {
                speakerGrid.innerHTML = '<p>No speaker info.</p>';
            }

            document.getElementById('organizer-avatar').src = event.organizerLogoUrl || 'https://via.placeholder.com/100x100';
            document.getElementById('organizer-name').textContent = event.organizerName || 'N/A';
        }
    });
</script>