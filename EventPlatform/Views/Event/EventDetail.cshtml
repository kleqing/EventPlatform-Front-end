        <form id="feedback-form">
            <div class="form-group rating-wrapper">
                <label class="rating-label">Your Rating</label>
                <div class="star-rating-input" id="star-rating-box">
                    <i class="fas fa-star" data-value="1"></i>
                    <i class="fas fa-star" data-value="2"></i>
                    <i class="fas fa-star" data-value="3"></i>
                    <i class="fas fa-star" data-value="4"></i>
                    <i class="fas fa-star" data-value="5"></i>
                </div>
                <input type="hidden" id="rating-value" value="0">
                <small id="rating-error" style="color: red; display: none;">Please select a rating.</small>
            </div>
            
            <div class="form-group">
                <textarea id="feedback-comment" placeholder="Write your experience about this event..." required></textarea>
