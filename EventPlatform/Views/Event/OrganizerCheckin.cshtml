@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Soát Vé Sự Kiện</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
            text-align: center;
        }

        #reader {
            width: 100%;
            max-width: 500px;
            margin: 0 auto;
        }

        #result-area {
            margin-top: 20px;
            padding: 20px;
            border-radius: 10px;
            display: none;
        }

        .success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        h2 {
            margin-top: 0;
        }

        .loader {
            border: 5px solid #f3f3f3;
            border-top: 5px solid #3498db;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            animation: spin 1s linear infinite;
            margin: 10px auto;
        }
        @@keyframes spin {
            0%

        {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }
    </style>
</head>
<body>
    <h1>Soát Vé Event</h1>

    <div id="reader"></div>

    <div id="result-area">
        <h2 id="status-title"></h2>
        <p id="status-msg"></p>
        <div id="customer-info" style="text-align: left; margin-top:10px;"></div>
        <button onclick="resetScanner()" style="padding:10px 20px; margin-top:15px; font-size:16px;">Quét tiếp</button>
    </div>

    <script>
        const API_BASE_URL = "https://localhost:7063";

        function onScanSuccess(decodedText, decodedResult) {
            // Dừng camera ngay khi quét được để tránh double-scan
            html5QrcodeScanner.clear();
            document.getElementById('reader').style.display = 'none'; 

            // Xử lý dữ liệu quét được (Bóc tách JSON)
            handleScannedData(decodedText);
        }

        // Hàm mới: Xử lý thông minh chuỗi quét được
        function handleScannedData(scannedText) {
            let tokenToSend = scannedText;

            console.log("Raw scanned data:", scannedText);

            // Kiểm tra xem có phải JSON không
            try {
                const dataObj = JSON.parse(scannedText);

                // Chấp nhận cả "Token" (hoa) và "token" (thường)
                if (dataObj.Token) {
                    tokenToSend = dataObj.Token;
                } else if (dataObj.token) {
                    tokenToSend = dataObj.token;
                }
                console.log("Extracted Token from JSON:", tokenToSend);

            } catch (e) {
                console.log("Non-JSON QR, using raw text.");
            }

            verifyTicket(tokenToSend.toString().trim());
        }

        async function verifyTicket(token) {
            const resultArea = document.getElementById('result-area');
            const statusTitle = document.getElementById('status-title');
            const statusMsg = document.getElementById('status-msg');
            const infoDiv = document.getElementById('customer-info');

            // Hiển thị khu vực kết quả với trạng thái Loading
            resultArea.style.display = 'block';
            resultArea.className = '';
            statusTitle.innerText = "Đang kiểm tra...";
            statusMsg.innerText = "";
            infoDiv.innerHTML = '<div class="loader"></div>';

            try {
                const response = await fetch(`${API_BASE_URL}/api/Checkin/verify-offline`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: token }) // Gửi token sạch lên
                });

                const data = await response.json();

                if (data.isValid) {
                    // --- TRƯỜNG HỢP HỢP LỆ ---
                    resultArea.className = 'success';
                    statusTitle.innerText = "✅ HỢP LỆ";
                    statusMsg.innerText = data.message;
                    infoDiv.innerHTML = `
                        <div style="border-top: 1px solid #ccc; padding-top: 10px; font-size: 1.1em;">
                            <p>👤 <strong>Khách:</strong> ${data.customerName}</p>
                            <p>🎫 <strong>Loại vé:</strong> ${data.ticketType}</p>
                            <p>📅 <strong>Sự kiện:</strong> ${data.eventName}</p>
                        </div>
                    `;
                } else {
                    // --- TRƯỜNG HỢP KHÔNG HỢP LỆ ---
                    resultArea.className = 'error';
                    statusTitle.innerText = "❌ KHÔNG HỢP LỆ";
                    statusMsg.innerText = data.message;

                    if (data.user) {
                        infoDiv.innerHTML = `<p>⚠️ Vé này thuộc về: <strong>${data.user}</strong></p>`;
                    } else {
                        infoDiv.innerHTML = "";
                    }
                }

            } catch (err) {
                // --- LỖI KẾT NỐI/SERVER ---
                resultArea.className = 'error';
                statusTitle.innerText = "⚠️ Lỗi Hệ Thống";
                statusMsg.innerText = "Không thể kết nối đến server: " + err.message;
                infoDiv.innerHTML = "";
            }
        }

        function resetScanner() {
            document.getElementById('result-area').style.display = 'none';
            document.getElementById('reader').style.display = 'block';

            html5QrcodeScanner.render(onScanSuccess);
        }

        let html5QrcodeScanner = new Html5QrcodeScanner(
            "reader",
            { fps: 10, qrbox: { width: 250, height: 250 } },
            false
        );
        html5QrcodeScanner.render(onScanSuccess);
    </script>
</body>
</html>